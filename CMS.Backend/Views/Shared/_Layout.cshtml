<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMS Admin</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CMS.Backend.styles.css" asp-append-version="true" />
</head>
<body>
    <div id="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar">
            <div class="sidebar-brand">
                <span><i class="fas fa-layer-group me-2"></i>HAI CMS</span>
            </div>
            <ul class="sidebar-nav">
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-home"></i> Trang chủ
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Category" asp-action="Index">
                        <i class="fas fa-tags"></i> Danh mục
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="CategoryProduct" asp-action="Index">
                        <i class="fas fa-boxes"></i> Danh mục SP
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Product" asp-action="Index">
                        <i class="fas fa-box-open"></i> Sản phẩm
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Customer" asp-action="Index">
                        <i class="fas fa-users"></i> Khách hàng
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Order" asp-action="Index">
                        <i class="fas fa-shopping-cart"></i> Đơn hàng
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Banner" asp-action="Index">
                        <i class="fas fa-images"></i> Banner
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Post" asp-action="Index">
                        <i class="fas fa-newspaper"></i> Bài viết
                    </a>
                </li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="User" asp-action="Index">
                            <i class="fas fa-user-shield"></i> Người dùng
                        </a>
                    </li>
                }
            </ul>
        </nav>

        <!-- Main Content -->
        <div id="content-wrapper">
            <!-- Topbar -->
            <nav class="topbar d-flex align-items-center justify-content-between mb-4">
                <button id="sidebarToggle">
                    <i class="fas fa-bars"></i>
                </button>
                
                <div class="d-flex align-items-center">
                    <div class="dropdown">
                        <a class="text-decoration-none text-dark d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="text-end d-none d-sm-block">
                                <span class="fw-semibold d-block">@(User.Identity.IsAuthenticated ? User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value ?? User.Identity.Name : "Khách")</span>
                                <small class="badge bg-primary text-white" style="font-size: 0.7rem; padding: 2px 6px;">@(User.Identity.IsAuthenticated ? User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value : "")</small>
                            </div>
                            <img src="https://ui-avatars.com/api/?name=@(User.Identity.Name)&background=4e73df&color=fff&rounded=true" width="35" height="35" alt="Avatar">
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-custom border-0 mt-2">
                            <li><a class="dropdown-item" href="#"><i class="fas fa-user fa-sm fa-fw mr-2 text-gray-400"></i> Profile</a></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-cogs fa-sm fa-fw mr-2 text-gray-400"></i> Settings</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i> Đăng xuất</a></li>
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Page Content -->
            <div class="container-fluid px-4 pb-5">
                @RenderBody()
            </div>
            
            <!-- Footer -->
            <footer class="mt-auto py-4 bg-white border-top">
                <div class="container-fluid text-center">
                    <span class="text-muted small">&copy; 2026 - CMS Backend by Trần Ngọc Hải - Cao Đẳng Công Thương TPHCM</span>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- Active Link Highlight Script -->
    <script>
        $(document).ready(function () {
            var path = window.location.pathname;
            $('.sidebar-nav .nav-link').each(function () {
                var href = $(this).attr('href');
                // Khắc phục lỗi: Không để /CategoryProduct highlight nhầm /Category
                if (path === href || (href !== '/' && (path + '/').startsWith(href + '/'))) {
                    $(this).addClass('active');
                } else if (path === '/' && href === '/') {
                    $(this).addClass('active');
                }
            });
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
