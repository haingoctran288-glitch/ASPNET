@model IEnumerable<CMS.Data.Entities.Banner>

@{
    ViewData["Title"] = "Quản lý Banner";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0"><i class="fas fa-images me-2"></i> Quản lý Banner</h3>
            <a asp-action="Create" class="btn btn-light btn-sm text-success fw-bold">
                <i class="fas fa-plus"></i> Thêm banner
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>HÌNH ẢNH</th>
                            <th>TIÊU ĐỀ</th>
                            <th>TRẠNG THÁI</th>
                            <th>THAO TÁC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">#@item.Id</span></td>
                                <td>
                                    <img src="@item.ImageUrl" style="height: 60px; object-fit: cover; border-radius: 4px;" onerror="this.onerror=null; this.src='https://via.placeholder.com/150';" />
                                </td>
                                <td class="fw-bold">@item.Title</td>
                                <td>
                                    @if(item.IsActive) {
                                        <span class="badge bg-success rounded-pill px-3 py-2">Đang hiển thị</span>
                                    } else {
                                        <span class="badge bg-danger rounded-pill px-3 py-2">Đã ẩn</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa banner này?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if(!Model.Any()) {
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-box-open fa-3x mb-3"></i>
                        <p>Chưa có banner nào.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
