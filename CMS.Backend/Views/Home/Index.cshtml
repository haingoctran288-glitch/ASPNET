@{
    ViewData["Title"] = "Hệ thống CMS - Admin";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">


<div class="welcome-section">
    <div class="container py-5">
        <div class="row mb-5 justify-content-center">
            <div class="col-lg-8 text-center hero-content">
                <div class="avatar-wrapper mb-4">
                    <img src="https://ui-avatars.com/api/?name=@(User.Identity.IsAuthenticated ? User.Identity.Name : "Ngoc+Hai")&background=dc3545&color=fff&size=128&rounded=false"
                         class="rounded-0 shadow-lg profile-img" alt="Avatar">
                </div>
                <h1 class="display-4 fw-bold mb-3 text-uppercase brand-font">Chào mừng trở lại, <span class="text-gradient">@(User.Identity.IsAuthenticated ? User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value ?? User.Identity.Name : "Khách")</span></h1>
                <p class="lead text-secondary mb-4">Hệ thống quản trị nội dung CMS đa nền tảng. Bạn muốn quản lý gì hôm nay?</p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="#" class="btn btn-outline-dark rounded-0 px-4 brand-font text-uppercase fw-bold">
                        <i class="fas fa-chart-line me-2"></i>Thống kê
                    </a>
                    <button class="btn btn-danger shadow rounded-0 px-4 brand-font text-uppercase fw-bold">
                        <i class="fas fa-rocket me-2"></i>Bắt đầu ngay
                    </button>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card-shortcut shadow-sm">
                    <div class="icon-box bg-soft-info">
                        <i class="fas fa-layer-group text-info"></i>
                    </div>

                    <h4>Danh mục sản phẩm</h4>

                    <p>
                        Quản lý nhóm sản phẩm và phân loại hàng hóa.
                    </p>

                    <a asp-controller="CategoryProduct"
                       asp-action="Index"
                       class="stretched-link text-decoration-none">

                        Truy cập
                        <i class="fas fa-arrow-right ms-1"></i>

                    </a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-shortcut shadow-sm">

                    <div class="icon-box bg-soft-danger">
                        <i class="fas fa-box-open text-danger"></i>
                    </div>

                    <h4>Sản phẩm</h4>

                    <p>
                        Quản lý danh sách sản phẩm và tồn kho.
                    </p>

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="stretched-link text-decoration-none">

                        Truy cập
                        <i class="fas fa-arrow-right ms-1"></i>

                    </a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-shortcut shadow-sm">

                    <div class="icon-box bg-soft-secondary">
                        <i class="fas fa-users text-secondary"></i>
                    </div>

                    <h4>Khách hàng</h4>

                    <p>
                        Theo dõi thông tin khách hàng hệ thống.
                    </p>

                    <a asp-controller="Customer"
                       asp-action="Index"
                       class="stretched-link text-decoration-none">

                        Truy cập
                        <i class="fas fa-arrow-right ms-1"></i>

                    </a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-shortcut shadow-sm">

                    <div class="icon-box bg-soft-success">
                        <i class="fas fa-cart-shopping text-success"></i>
                    </div>

                    <h4>Đơn hàng</h4>

                    <p>
                        Quản lý trạng thái và lịch sử đơn hàng.
                    </p>

                    <a asp-controller="Order"
                       asp-action="Index"
                       class="stretched-link text-decoration-none">

                        Truy cập
                        <i class="fas fa-arrow-right ms-1"></i>

                    </a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-shortcut shadow-sm">

                    <div class="icon-box bg-soft-primary">
                        <i class="fas fa-file-invoice-dollar text-primary"></i>
                    </div>

                    <h4>Chi tiết đơn hàng</h4>

                    <p>
                        Xem thông tin sản phẩm trong từng đơn hàng.
                    </p>

                    <a asp-controller="OrderDetail"
                       asp-action="Index"
                       class="stretched-link text-decoration-none">

                        Truy cập
                        <i class="fas fa-arrow-right ms-1"></i>

                    </a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card-shortcut shadow-sm">
                    <div class="icon-box bg-soft-primary"><i class="fas fa-file-alt text-primary"></i></div>
                    <h4>Bài viết</h4>
                    <p>Quản lý các tin tức, bài viết và lộ trình học tập.</p>
                    <a asp-controller="Post" asp-action="Index" class="stretched-link text-decoration-none">Truy cập <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="col-md-4">
                    <div class="card-shortcut shadow-sm">
                        <div class="icon-box bg-soft-success"><i class="fas fa-user-shield text-success"></i></div>
                        <h4>Người dùng</h4>
                        <p>Quản trị viên, biên tập viên và quyền truy cập hệ thống.</p>
                        <a asp-controller="User" asp-action="Index" class="stretched-link text-decoration-none">Truy cập <i class="fas fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            }

            <div class="col-md-4">
                <div class="card-shortcut shadow-sm">
                    <div class="icon-box bg-soft-warning"><i class="fas fa-tags text-warning"></i></div>
                    <h4>Danh mục</h4>
                    <p>Phân loại chủ đề và cấu trúc dữ liệu Backend.</p>
                    <a asp-controller="Category" asp-action="Index" class="stretched-link text-decoration-none">Truy cập <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --primary: #dc3545;
        --success: #198754;
        --warning: #ffc107;
        --dark-blue: #111111;
    }

    body {
        background-color: #f8f9fa;
        font-family: 'Inter', sans-serif;
    }

    /* Hiệu ứng chữ Gradient */
    .text-gradient {
        background: linear-gradient(90deg, #dc3545, #111111);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* Profile Image Animation */
    .profile-img {
        border: 5px solid white;
        transition: transform 0.3s ease;
    }

        .profile-img:hover {
            transform: scale(1.1) rotate(5deg);
        }

    /* Thẻ lối tắt (Shortcuts) */
    .card-shortcut {
        background: white;
        padding: 2rem;
        border-radius: 0px;
        border: 1px solid #dee2e6;
        transition: all 0.3s ease;
        height: 100%;
        position: relative;
    }

        .card-shortcut:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
            border-color: var(--primary);
        }

    .icon-box {
        width: 60px;
        height: 60px;
        border-radius: 0px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .bg-soft-primary {
        background-color: #f8d7da;
    }

    .bg-soft-success {
        background-color: #d1e7dd;
    }

    .bg-soft-warning {
        background-color: #fff3cd;
    }

    .bg-soft-info {
        background-color: #cff4fc;
    }

    .bg-soft-danger {
        background-color: #f8d7da;
    }

    .bg-soft-secondary {
        background-color: #e2e3e5;
    }

    .card-shortcut h4 {
        font-family: 'Oswald', sans-serif;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--dark-blue);
    }

    .card-shortcut a {
        font-family: 'Oswald', sans-serif;
        font-weight: 600;
        font-size: 1rem;
        text-transform: uppercase;
        color: var(--primary);
        display: inline-block;
        margin-top: 1rem;
    }

    /* Animation cho toàn bộ trang */
    .hero-content {
        animation: fadeInUp 0.8s ease-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>