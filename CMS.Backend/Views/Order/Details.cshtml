@model CMS.Data.Entities.Order
@{
    ViewData["Title"] = "Chi tiết Order";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-info text-white">
            <h3 class="mb-0"><i class="fas fa-info-circle me-2"></i>Chi tiết Order</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.OrderDate)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.OrderDate)</dd>
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Status)</dd>
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Notes)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Notes)</dd>
                <dt class="col-sm-3">Customer</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Customer.FullName)</dd>
            </dl>
            
            <div class="d-flex justify-content-between align-items-center mt-4 mb-3 border-bottom pb-2">
                <h5 class="mb-0">Danh sách sản phẩm</h5>
                <a asp-controller="OrderDetail" asp-action="Create" asp-route-orderId="@Model.Id" class="btn btn-sm btn-success"><i class="fas fa-plus"></i> Thêm sản phẩm</a>
            </div>
            @if(Model.OrderDetails != null && Model.OrderDetails.Any())
            {
                <table class="table table-bordered table-striped">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Size</th>
                            <th>Số lượng</th>
                            <th>Đơn giá</th>
                            <th>Thành tiền</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var detail in Model.OrderDetails)
                        {
                            <tr>
                                <td>@(string.IsNullOrEmpty(detail.Product?.Name) ? "Không có" : detail.Product.Name)</td>
                                <td><span class="badge bg-secondary">@(string.IsNullOrEmpty(detail.Size) ? "Không có" : detail.Size)</span></td>
                                <td>@detail.Quantity</td>
                                <td>@detail.UnitPrice.ToString("N0") đ</td>
                                <td>@((detail.Quantity * detail.UnitPrice).ToString("N0")) đ</td>
                                <td class="text-center">
                                    <a asp-controller="OrderDetail" asp-action="Edit" asp-route-id="@detail.Id" class="btn btn-sm btn-outline-warning" title="Sửa"><i class="fas fa-edit"></i></a>
                                    <form asp-controller="OrderDetail" asp-action="Delete" asp-route-id="@detail.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa chi tiết này?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="text-end fw-bold">Tổng cộng:</td>
                            <td class="fw-bold text-danger">@Model.OrderDetails.Sum(d => d.Quantity * d.UnitPrice).ToString("N0") đ</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            }
            else
            {
                <p class="text-muted">Không có chi tiết sản phẩm.</p>
            }

            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning"><i class="fas fa-edit me-1"></i>Sửa</a>
                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
            </div>
        </div>
    </div>
</div>
