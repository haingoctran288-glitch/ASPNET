@model IEnumerable<CMS.Data.Entities.Order>

@{
    ViewData["Title"] = "Danh sách đơn hàng";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="container mt-5">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-0">
        <div class="card-header bg-dark text-white rounded-0">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h3 class="mb-0 text-uppercase fw-bold brand-font">
                        <i class="fas fa-cart-shopping me-2 text-danger"></i>
                        Quản lý đơn hàng
                    </h3>
                    <small class="text-white-50">Tổng cộng @(Model?.Count() ?? 0) đơn hàng</small>
                </div>
                <a asp-action="Create" class="btn btn-danger btn-sm rounded-0 fw-bold text-uppercase">
                    <i class="fas fa-plus me-1"></i> Tạo đơn hàng
                </a>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Ngày đặt</th>
                            <th>Customer ID</th>
                            <th>Trạng thái</th>
                            <th>Ghi chú</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                string statusText = "Chờ duyệt";
                                string statusBadge = "bg-warning text-dark";
                                string statusIcon = "fa-clock";

                                if (item.Status == 1)
                                {
                                    statusText = "Đang giao";
                                    statusBadge = "bg-info text-white";
                                    statusIcon = "fa-truck";
                                }
                                else if (item.Status == 2)
                                {
                                    statusText = "Đã xong";
                                    statusBadge = "bg-success text-white";
                                    statusIcon = "fa-check-circle";
                                }

                                <tr>
                                    <td class="fw-bold ps-4">#@item.Id</td>
                                    <td>@item.OrderDate.ToString("dd/MM/yyyy")</td>
                                    <td>KH-@item.CustomerId</td>
                                    <td>
                                        <span class="badge @statusBadge rounded-0 px-3 py-2 fw-bold text-uppercase">
                                            <i class="fas @statusIcon me-1"></i> @statusText
                                        </span>
                                    </td>
                                    <td>@item.Notes</td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm rounded-0 text-white"><i class="fas fa-eye"></i></a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm rounded-0 text-dark"><i class="fas fa-edit"></i></a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline m-0" onsubmit="return confirm('Xóa đơn hàng này?');">
                                                <button type="submit" class="btn btn-danger btn-sm rounded-0"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-box-open fs-1 d-block mb-3"></i>
                                    Chưa có đơn hàng nào
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
