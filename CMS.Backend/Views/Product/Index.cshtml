@model IEnumerable<CMS.Data.Entities.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container mt-5">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-uppercase mb-1">Danh sách sản phẩm</h2>
            <p class="text-muted mb-0">Hiển thị @Model.Count() / @ViewBag.TotalItems sản phẩm</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-0"><i class="bi bi-plus-circle me-2"></i>Thêm mới</a>
    </div>

    <!-- Bộ lọc -->
    <div class="card shadow-sm border-0 mb-4 rounded-0">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row gx-3 gy-2 align-items-center">
                <div class="col-sm-5">
                    <label class="visually-hidden" for="categoryId">Danh mục</label>
                    <div class="input-group">
                        <div class="input-group-text bg-white rounded-0"><i class="bi bi-funnel"></i></div>
                        <select name="categoryId" id="categoryId" class="form-select rounded-0" asp-items="ViewBag.CategoryList"></select>
                    </div>
                </div>
                <div class="col-sm-auto">
                    <button type="submit" class="btn btn-dark rounded-0 px-4"><i class="bi bi-search me-2"></i>Lọc</button>
                </div>
                @if (ViewBag.CategoryId != null && ViewBag.CategoryId > 0)
                {
                    <div class="col-sm-auto">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-0">Xóa lọc</a>
                    </div>
                }
            </form>
        </div>
    </div>

    <div class="row">

        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">

                    <div class="card product-card shadow border-0 h-100 rounded-0">

                        <!-- IMAGE -->
                        <div class="overflow-hidden rounded-0 position-relative"
                             style="height:250px;">
                            
                            @if (item.ProductTag == "HOT") {
                                <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-3 py-2 rounded-0 shadow-sm" style="z-index: 1;"><i class="bi bi-fire me-1"></i>HOT</span>
                            } else if (item.ProductTag == "Mới") {
                                <span class="badge bg-success position-absolute top-0 start-0 m-3 px-3 py-2 rounded-0 shadow-sm" style="z-index: 1;"><i class="bi bi-stars me-1"></i>MỚI</span>
                            }

                            <img src="@(string.IsNullOrEmpty(item.ImageUrl)
                                                                         ? "https://via.placeholder.com/400x250?text=No+Image"
                                                                         : item.ImageUrl)"
                          class="w-100 h-100 product-img"
                          style="object-fit:cover;"
                          alt="@item.Name" />

                        </div>

                        <!-- BODY -->
                        <div class="card-body p-4">

                            <h4 class="fw-bold mb-3">
                                @item.Name
                            </h4>

                            <p class="text-muted small">
                                @item.Description
                            </p>
                            @if(!string.IsNullOrEmpty(item.Sizes)) {
                                <p class="small mb-0"><strong>Size:</strong> @item.Sizes</p>
                            }

                            <div class="d-flex justify-content-between align-items-center mt-4">

                                <span class="price-tag">
                                    @item.Price.ToString("N0") ₫
                                </span>

                                <span class="badge bg-primary">
                                    Kho: @item.StockQuantity
                                </span>

                            </div>

                        </div>

                        <!-- FOOTER -->
                        <div class="card-footer bg-transparent border-0 p-4 pt-0">

                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info w-50 rounded-0 text-white"><i class="bi bi-info-circle me-1"></i>Xem</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning w-50 rounded-0 text-white"><i class="bi bi-pencil-square me-1"></i>Sửa</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="w-50 m-0 p-0" onsubmit="return confirm('Bạn có chắc muốn xóa?');">
                                    <button type="submit" class="btn btn-danger w-100 rounded-0"><i class="bi bi-trash me-1"></i>Xóa</button>
                                </form>
                            </div>

                        </div>

                    </div>

                </div>
                }
        }
        else
        {
            <div class="col-12 text-center py-5">

                <i class="bi bi-box-seam display-1 text-muted"></i>

                <h4 class="mt-3 text-muted">
                    Chưa có sản phẩm nào
                </h4>

            </div>
        }

    </div>

    <!-- Phân trang -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4 mb-5">
            <ul class="pagination justify-content-center">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link rounded-0 text-dark" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, categoryId = ViewBag.CategoryId })" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                        <a class="page-link rounded-0 @(ViewBag.CurrentPage == i ? "bg-dark border-dark" : "text-dark")" href="@Url.Action("Index", new { page = i, categoryId = ViewBag.CategoryId })">@i</a>
                    </li>
                }
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link rounded-0 text-dark" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, categoryId = ViewBag.CategoryId })" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    }

</div>

<style>

    body {
        background: #f8f9fc;
    }

    .product-card {
        transition: all 0.3s ease;
    }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.12) !important;
        }

    .product-img {
        transition: transform 0.5s ease;
    }

    .product-card:hover .product-img {
        transform: scale(1.08);
    }

    .price-tag {
        color: #e74a3b;
        font-size: 20px;
        font-weight: bold;
    }

    .btn-dark {
        background: #2c3e50;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-dark:hover {
            background: #4e73df;
        }

</style>
