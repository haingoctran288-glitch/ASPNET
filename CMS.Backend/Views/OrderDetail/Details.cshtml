@model CMS.Data.Entities.OrderDetail
@{
    ViewData["Title"] = "Chi tiết OrderDetail";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-info text-white">
            <h3 class="mb-0"><i class="fas fa-info-circle me-2"></i>Chi tiết OrderDetail</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Quantity)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Quantity)</dd>
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.UnitPrice)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.UnitPrice)</dd>
                <dt class="col-sm-3">Order</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Order.Id)</dd>
                <dt class="col-sm-3">Product</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Product.Name)</dd>
            </dl>
            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning"><i class="fas fa-edit me-1"></i>Sửa</a>
                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
            </div>
        </div>
    </div>
</div>
